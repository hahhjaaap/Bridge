{
  "manifest_version": 3,
  "name": "UDB Aura — AI Tab Identity",
  "short_name": "UDB Aura",
  "version": "0.1.0",
  "description": "Distinguish explicitly UDB-opened Chrome tabs with an AI tab group and a lightweight RGB page badge.",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "UDB Aura • AI tabs",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
